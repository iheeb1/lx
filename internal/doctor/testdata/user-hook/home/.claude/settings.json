{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "@ROOT@/bin/lx hook claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(lx git status:*)"
    ]
  }
}
